{
  "procedure": {
    "tag": "!procedure",
    "syntax": "memsphere-20261027-stable",
    "mode": "graph",
    "names": [
      "analyze-materials",
      "逐份分析资料"
    ],
    "defines": [
      "准备资料，逐份分析并评审，收集结果后形成总结。"
    ],
    "goals": [],
    "actions": [
      {
        "tag": "!action",
        "id": "prepare",
        "description": "准备待分析资料",
        "actor": "agent",
        "dependencies": [
          {
            "tag": "!dependency",
            "from": "START"
          }
        ],
        "artifact": {
          "name": "待分析资料",
          "model": {
            "definedBy": "json-schema/draft-07.json",
            "definition": "{\"type\": \"object\", \"properties\": {\"remaining\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"remaining\"], \"additionalProperties\": false}"
          },
          "payload": {
            "contentType": "application/json"
          }
        }
      },
      {
        "tag": "!action",
        "id": "check",
        "description": "检查剩余资料",
        "actor": "agent",
        "dependencies": [
          {
            "tag": "!dependency",
            "from": "prepare"
          },
          {
            "tag": "!dependency",
            "from": "analyze"
          }
        ],
        "artifact": {
          "name": "剩余资料检查",
          "model": {
            "definedBy": "json-schema/draft-07.json",
            "definition": "{\"type\": \"object\", \"properties\": {\"hasMore\": {\"type\": \"boolean\"}, \"remaining\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"hasMore\", \"remaining\"], \"additionalProperties\": false}"
          },
          "payload": {
            "contentType": "application/json"
          }
        }
      },
      {
        "tag": "!action",
        "id": "analyze",
        "description": "分析一份资料",
        "actor": "agent",
        "dependencies": [
          {
            "tag": "!dependency",
            "from": "check",
            "when": "artifacts.check.hasMore = true"
          }
        ],
        "artifact": {
          "name": "单份资料分析",
          "model": {
            "definedBy": "json-schema/draft-07.json",
            "definition": "{\"type\": \"object\", \"properties\": {\"material\": {\"type\": \"string\", \"description\": \"当前分析的资料\"}, \"finding\": {\"type\": \"string\", \"description\": \"依据资料形成的结论\"}, \"remaining\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"material\", \"finding\", \"remaining\"], \"additionalProperties\": false}"
          },
          "payload": {
            "contentType": "application/json"
          },
          "review": [
            "领域专家"
          ]
        }
      },
      {
        "tag": "!action",
        "id": "gather",
        "description": "收集分析结果",
        "dependencies": [
          {
            "tag": "!dependency",
            "from": "check",
            "when": "artifacts.check.hasMore = false"
          }
        ],
        "collect": [
          "analyze"
        ]
      },
      {
        "tag": "!action",
        "id": "summarize",
        "description": "生成分析总结",
        "actor": "agent",
        "dependencies": [
          {
            "tag": "!dependency",
            "from": "gather"
          }
        ],
        "artifact": {
          "name": "分析总结",
          "model": {
            "definedBy": "raw.json",
            "definition": "{}"
          },
          "payload": {
            "contentType": "text/markdown"
          }
        }
      }
    ]
  },
