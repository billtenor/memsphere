{
  "name": "vibe-mem",
  "version": "0.1.0",
  "description": "A local YAML-backed memory CLI for AI runtimes.",
  "license": "Apache-2.0",
  "author": "Yanjun Liu <billtenor.thu@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billtenor/memsphere.git"
  },
  "homepage": "https://github.com/billtenor/memsphere#readme",
  "bugs": {
    "url": "https://github.com/billtenor/memsphere/issues"
  },
  "type": "module",
  "bin": {
    "vibe-mem": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/skills','dist/skills',{recursive:true})\"",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
