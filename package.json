{
  "name": "memsphere",
  "version": "0.1.1",
  "description": "A local YAML-backed memory CLI for AI runtimes.",
  "license": "Apache-2.0",
  "author": "Yanjun Liu <billtenor.thu@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billtenor/memsphere.git"
  },
  "homepage": "https://github.com/billtenor/memsphere#readme",
  "bugs": {
    "url": "https://github.com/billtenor/memsphere/issues"
  },
  "type": "module",
  "bin": {
    "memsphere": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./artifact-validation": "./dist/artifact-validation.js",
    "./control-plane": "./dist/control-plane.js",
    "./run": "./dist/run/store.js"
  },
  "files": [
    "dist",
    "reserved-memory",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.en.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"const fs=require('node:fs'); fs.chmodSync('dist/cli.js',0o755); fs.cpSync('src/skills','dist/skills',{recursive:true}); fs.cpSync('src/prompts/templates','dist/prompts/templates',{recursive:true})\"",
    "dev": "tsx src/cli.ts",
    "test": "node scripts/run-tests.mjs",
    "test:ci": "node scripts/run-tests.mjs --test-concurrency=1",
    "smoke:project": "node scripts/project-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "npm run build",
    "security:check": "sh scripts/security-check.sh --staged",
    "security:audit": "sh scripts/security-check.sh --all",
    "security:range": "sh scripts/security-check.sh --range",
    "security:setup": "sh scripts/security-setup.sh",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.2.1",
    "commander": "^12.1.0",
    "cross-spawn": "^7.0.6",
    "handlebars": "^4.7.9",
    "markdown-it": "^14.3.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.5.4",
    "husky": "^9.1.7",
    "playwright": "^1.55.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
