{
  "name": "memsphere",
  "version": "0.1.1",
  "description": "A local YAML-backed memory CLI for AI runtimes.",
  "type": "module",
  "bin": {
    "memsphere": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./artifact-validation": "./dist/artifact-validation.js",
    "./control-plane": "./dist/control-plane.js",
    "./run": "./dist/run/store.js"
  },
  "files": [
    "dist",
    "reserved-memory"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/skills','dist/skills',{recursive:true})\"",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.2.1",
    "commander": "^12.1.0",
    "markdown-it": "^14.3.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.5.4",
    "playwright": "^1.55.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
