      "reviewer": {
        "role": "reviewer",
        "actorId": "owner"
      },
      "status": "submitted",
      "comments": [],
      "createdAt": "2026-10-22T08:03:00Z",
      "startedAt": "2026-10-22T08:03:00Z",
      "endedAt": "2026-10-22T08:04:00Z",
      "vote": {
        "value": "approve"
      }
    },
    {
      "id": "review-agent-2",
      "roundId": "round-design-2",
      "artifactId": "artifact-design-2",
      "reviewer": {
        "role": "reviewer",
        "actorId": "code-reviewer"
      },
      "status": "running",
      "comments": [
        {
          "id": "comment-draft",
          "body": "正在核对恢复步骤。",
          "createdAt": "2026-10-22T08:04:00Z"
        }
      ],
      "createdAt": "2026-10-22T08:03:00Z",
      "startedAt": "2026-10-22T08:03:00Z",
