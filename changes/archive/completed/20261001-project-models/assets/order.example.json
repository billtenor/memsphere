{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "订单",
  "description": "用于检查模型字段树的示例定义，不自动安装到 Project。",
  "type": "object",
  "properties": {
    "orderNo": { "type": "string", "description": "订单编号" },
    "items": {
      "type": "array",
      "description": "订单明细",
      "items": {
        "type": "object",
        "properties": {
          "productId": { "type": "string", "description": "商品编号" },
          "quantity": { "type": "integer", "minimum": 1, "description": "数量" }
        },
        "required": ["productId", "quantity"]
      }
    }
  },
  "required": ["orderNo", "items"]
}
