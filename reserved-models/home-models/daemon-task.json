{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DaemonTask",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "status",
    "input",
    "recipient",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "input": {
      "type": "object"
    },
    "recipient": {
      "type": "object"
    },
    "error": {
      "type": "object"
    },
    "daemonInstanceId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  }
}
