{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "用例 02 · 订单与深层嵌套",
  "description": "对象套对象、对象套数组、数组套对象；订单、明细、规格、价格与收货信息的多级结构。",
  "type": "object",
  "properties": {
    "orderNo": { "type": "string", "description": "订单编号。" },
    "status": { "type": "string", "enum": ["created", "paid", "shipped"], "description": "订单状态。" },
    "customer": {
      "type": "object", "description": "买家；必填依据 customer 自己的 required。",
      "properties": {
        "id": { "type": "string", "description": "买家 ID。" },
        "profile": {
          "type": "object", "properties": {
            "displayName": { "type": "string" },
            "preferences": { "type": "object", "properties": { "smsEnabled": { "type": "boolean" }, "languages": { "type": "array", "items": { "type": "string" } } }, "required": ["smsEnabled"] }
          }, "required": ["displayName"]
        }
      }, "required": ["id"]
    },
    "items": {
      "type": "array", "description": "订单明细；展开数组元素后查看字段。", "minItems": 1,
      "items": {
        "type": "object", "properties": {
          "lineId": { "type": "string" },
          "product": {
            "type": "object", "properties": {
              "sku": { "type": "string" },
              "attributes": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "values": { "type": "array", "items": { "type": "string" } } }, "required": ["name", "values"] } }
            }, "required": ["sku"]
          },
          "quantity": { "type": "integer", "minimum": 1 },
          "unitPrice": { "type": "object", "properties": { "amount": { "type": "number", "minimum": 0 }, "currency": { "type": "string", "enum": ["CNY", "USD", "EUR"] } }, "required": ["amount", "currency"] },
          "gift": { "type": "boolean", "default": false }
        }, "required": ["lineId", "product", "quantity", "unitPrice"]
      }
    },
    "delivery": {
      "type": "object", "properties": {
        "address": { "type": "object", "properties": { "city": { "type": "string" }, "street": { "type": "string" }, "location": { "type": "object", "properties": { "latitude": { "type": "number" }, "longitude": { "type": "number" } }, "required": ["latitude", "longitude"] } }, "required": ["city", "street"] },
        "instructions": { "type": "string", "description": "可选配送备注。" }
      }, "required": ["address"]
    }
  },
  "required": ["orderNo", "items", "customer"]
}
