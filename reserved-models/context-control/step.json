        "id": {
          "$ref": "#/definitions/SubmittedId",
          "description": "产物的稳定标识；草稿更新和提交保持同一 ID，提交后修改内容须创建新 ID，调整 tags 不改变 ID。"
        },
        "stepId": {
          "$ref": "#/definitions/SubmittedId",
          "description": "生产该产物的 Step；所属 Run 和生产者由该 Step 确定。"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "产物名称。"
        },
        "status": {
          "type": "string",
          "title": "产物状态",
          "enum": [
            "draft",
            "submitted"
          ],
          "description": "draft 为草稿，可修改且只保存当前内容；submitted 为已提交，除 tags 外的字段及所引用内容固定。只允许从 draft 变为 submitted，不允许退回草稿。tags 为分类信息，可更新且不影响已固定的依赖。评审结果由 Review 记录，当前成果及最终交付根由完整 Artifact 的依赖、修订关系与 Run.outputOverrides 人工增删共同推导。"
        },
        "tags": {
          "type": "array",
          "title": "标签",
          "description": "所属 Run 内生效的产物标签；由 stepId 确定 Run，同名标签不跨 Run 关联。创建时自动包含 default，可添加自定义标签；每份 Artifact 都须保留 default，同一标签不重复。标签可更新，不改变产物 ID、内容或已提交的依赖。按标签上报依赖只在本次提交时展开当前 Run 已提交的匹配产物 ID，后续打标签不会追加历史产物的依赖。",
          "items": {
            "type": "string",
            "title": "标签名称",
            "description": "所属 Run 内使用的标签名称。",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "content": {
          "$ref": "#/definitions/SubmittedContent",
          "description": "直接保存的产物模型和正文，与contentRef互斥；声明无正文draft时可都省略，提交时必须二选一。"
        },
        "contentRef": {
          "$ref": "#/definitions/SubmittedContentRef",
          "title": "产物内容引用",
          "description": "固定产物的内容引用，与content互斥；无正文draft可省略，submitted必须提供一个内容入口。"
        },
        "dependencies": {
          "type": "array",
          "description": "生产这份产物实际使用的材料，可引用同一 Run 中 status=submitted 的 Artifact 或内容已固定的 External；禁止自依赖，依赖图须无环。草稿期间可调整，提交后固定；无依赖时为空数组。 按标签选择依赖时保存展开后的具体 Artifact ID，不保存 tag 引用，也不随标签变化更新。",
          "items": {
            "$ref": "#/definitions/SubmittedDependencyRef"
          },
          "uniqueItems": true
        },
        "revisedFrom": {
          "$ref": "#/definitions/SubmittedId",
          "description": "本次修订所替代的已提交 Artifact ID，须属于同一 Run，可来自同一 Step 或其他 Step；不得指向自身，修订关系不得成环。"
        },
        "revisedSummary": {
          "type": "string",
          "minLength": 1,
          "description": "本次修改的说明，包括已解决和仍未解决的问题。"
        }
      },
      "required": [
        "id",
        "stepId",
        "name",
        "status",
        "tags",
        "dependencies"
      ],
      "additionalProperties": false
    },
