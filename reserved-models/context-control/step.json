    "ReviewRound": {
      "type": "object",
      "title": "评审轮次",
      "description": "本 Step 一轮评审的固定要求、意见处理总结与逐条处理记录。id、artifactId、reviewConfig、createdAt 在创建个人 Review 前确定并保持不变；resolutionSummary 和 resolutions 由 Runner 随处理进度更新。个人评论、投票和执行状态保存在 Review 中。",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id",
