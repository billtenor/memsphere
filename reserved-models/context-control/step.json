          "title": "评审配置",
          "description": "本轮固定的参与名单、决策策略与权限。"
        },
        "createdAt": {
          "$ref": "#/definitions/Timestamp",
          "title": "开启时间",
          "description": "本轮固定配置并开始组织评审的时间。"
        },
        "resolutionSummary": {
          "type": "string",
          "title": "处理总结",
          "description": "Runner 对本轮评审意见处理情况的整体总结，包括主要修改、处理结论和后续安排；逐条处理细节保存在 resolutions。可随处理进度更新，尚无总结时省略。",
          "minLength": 1
        },
        "resolutions": {
          "type": "array",
          "title": "评论处理结果",
          "description": "Runner 对本轮已提交评论的处理记录，通过 reviewId + commentId 关联；没有处理记录时省略或为空数组。可在评审进行中或本轮结束后更新，不改变已固定的产物、参与名单和策略。",
          "items": {
            "$ref": "#/definitions/Resolution",
            "title": "处理记录",
            "description": "Runner 对一条评论的处理方式和说明。"
          }
        }
      },
